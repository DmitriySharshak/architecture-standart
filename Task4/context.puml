@startuml C4_Context
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

title Диаграмма контекста: Система распространения ставок кол-центрам

Person(operatorCall, "Оператор кол-центра банка", "Сотрудник внутреннего кол-центра консультирует клиентов по телефону")
Person(operatorPartner, "Оператор партнёрского кол-центра", "Сотрудник внешнего кол-центра использует файлы со ставками")

System(systemRate, "Система управления и распространения ставок", "Централизованная система для управления депозитными ставками и их распространения")
System(systemCall, "Система кол-центра банка", "Внутренняя CRM-система кол-центра с доступом к актуальным ставкам")

' Внешние системы
System_Ext(systemPartner, "Система партнёрского кол-центра", "Внешняя система партнёра получает ставки через файлы")

' Взаимодействия с людьми
Rel(operatorCall, systemRate, "Запрашивает актуальные ставки для консультации клиентов", "HTTPS/Web UI")
Rel(operatorPartner, systemPartner, "Использует ставки из полученных файлов", "Desktop/Web UI")

' Взаимодействия между системами
Rel(systemRate, systemCall, "REST API, ставки в реальном времени", "JSON")
Rel(systemRate, systemPartner, "SFTP + файлы CSV (ставки с задержкой 15 мин)", "SFTP/CSV")

@enduml