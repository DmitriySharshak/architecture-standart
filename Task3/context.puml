@startuml C4_Context
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

title Диаграмма контекста: Система "Онлайн-депозиты"

Person(client, "Cуществующий клиент", "Клиент банка, который хочет открыть депозит через интернет-банк")
Person(newClient, "Новый клиент", "Клиент, который хочет открыть депозит через сайт банка")
Person(operator, "Оператор кол-центра", "Сотрудник кол-центра, который обрабатывает заявки и консультирует клиентов")
Person(manager, "Менеджер бэк-офиса", "Сотрудник депозитного отдела, который проверяет и подтверждает заявки на открытие депозитов")

System(sys, "Система онлайн-депозитов", "Открытие депозитов через цифровые каналы (сайт и интернет-банк)")

System_Ext(abc, "АБС", "Основная система банка для учёта операций и хранения данных")
System_Ext(call, "Система кол-центра", "CRM-система для управления обращениями клиентов и обработки заявок")
System_Ext(sms, "СМС-шлюз", "Шлюз для отправки СМС-сообщений клиентам")
System_Ext(telecom, "Телеком-оператор", "Внешний оператор связи для отправки СМС")

' Связи с пользователями
Rel(client, sys, "Открывает депозит", "HTTPS")
Rel(newClient, sys, "Оставляет заявку на депозит через сайт", "HTTPS")
Rel(operator, sys, "Консультирует клиентов, создаёт заявки", "Веб-интерфейс")
Rel(manager, sys, "Проверяет и подтверждает заявки на депозиты", "Веб-интерфейс/АБС клиент")

' Связи с внешними системами
Rel(sys, abc, "1. Запрашивает данные о клиенте (баланс, история)\n2. Создаёт заявки на открытие депозитов\n3. Получает статусы обработки", "REST API/Очередь сообщений")
Rel(sys, call, "1. Передаёт заявки с сайта для обработки\n2. Получает статусы по заявкам", "REST API")
Rel(sys, sms, "Отправляет СМС-коды для подтверждения операций\nи уведомления об открытии депозита", "HTTP/SMPP")
Rel(sms, telecom, "Передаёт СМС для отправки", "Протокол оператора")

@enduml